rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Conta com até 2 personagens: slot "1" sempre; slot "2" só se a conta
    // tiver um slot extra liberado em entitlements (ver abaixo). O teto de
    // nível é 110 — só quem tem o talento único "Rompendo Limites" passa
    // de 100 de verdade (TalentService.js), mas a regra não distingue
    // quem tem o talento, então aceita até o teto pros dois casos.
    match /saves/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.version == 2
        && request.resource.data.slots is map
        && request.resource.data.slots.keys().hasOnly(['1', '2'])
        && request.resource.data.slots['1'].level is number
        && request.resource.data.slots['1'].level >= 1
        && request.resource.data.slots['1'].level <= 110
        && request.resource.data.slots['1'].get('gold', 0) >= 0
        && (
          !('2' in request.resource.data.slots)
          || (
            request.resource.data.slots['2'].level is number
            && request.resource.data.slots['2'].level >= 1
            && request.resource.data.slots['2'].level <= 110
            && request.resource.data.slots['2'].get('gold', 0) >= 0
            && exists(/databases/$(database)/documents/entitlements/$(uid))
            && get(/databases/$(database)/documents/entitlements/$(uid)).data.extraSlots >= 1
          )
        );
      allow delete: if isOwner(uid);
    }

    // Só o servidor (ou você, no console) libera slots extras. O jogador lê
    // o próprio direito, mas nunca escreve nele.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /characterNames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && name.size() <= 30;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Id da entrada = "uid_slot" (uma por personagem). O dono é a parte antes do "_".
    match /leaderboard/{entryId} {
      allow read: if signedIn();
      allow delete: if signedIn() && entryId.split('_')[0] == request.auth.uid;
      allow create, update: if signedIn()
        && entryId.split('_')[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 110
        && request.resource.data.power is number
        && request.resource.data.power >= 0
        && request.resource.data.power <= 500000;
    }

    // Correio — provisório (ver js/services/MailService.js): só a conta
    // admin abaixo pode mandar carta normal. O uid é o MESMO de
    // js/data/admins.js — os dois precisam ficar sincronizados à mão,
    // regra não lê o array do código. "Devolução automática" (carta
    // expirada depois de 30 dias sem coleta) é a ÚNICA outra forma de
    // criar uma carta, e só pode entrar na caixa do próprio admin — ou
    // seja, mesmo alguém forjando uma devolução falsa não ganha nada
    // pra si, só "suja" a caixa do admin. Quando existir envio
    // jogador→jogador, essa parte da regra precisa ficar bem mais
    // rígida (hoje ela não confirma que a carta original expirada de
    // verdade existiu).
    match /mail/{recipientUid}/letters/{letterId} {

      allow read, delete: if isOwner(recipientUid);

      allow create: if signedIn()
        && recipientUid != request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 60
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 30
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 250
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3
        && request.resource.data.sentAt is number
        && request.resource.data.expiredReturn is bool
        && (
          (request.auth.uid == "qgZA5v7Q1IWLjYc99bNrrRJd14X2" && request.resource.data.expiredReturn == false)
          || (request.resource.data.expiredReturn == true && recipientUid == "qgZA5v7Q1IWLjYc99bNrrRJd14X2")
        );

    }

  }
}
