rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Conta com até 2 personagens: slot "2" só se a conta tiver um slot
    // extra liberado em entitlements (ver abaixo). O teto de nível é
    // 110 — só quem tem o talento único "Rompendo Limites" passa de 100
    // de verdade (TalentService.js), mas a regra não distingue quem tem
    // o talento, então aceita até o teto pros dois casos. Nenhum dos
    // dois slots é obrigatório — excluir um personagem (ver
    // SaveService.deleteCharacterSlot) grava a conta SEM aquele slot,
    // então a validação de cada um só roda SE ele existir.
    match /saves/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.version == 2
        && request.resource.data.slots is map
        && request.resource.data.slots.keys().hasOnly(['1', '2'])
        && (
          !('1' in request.resource.data.slots)
          || (
            request.resource.data.slots['1'].level is number
            && request.resource.data.slots['1'].level >= 1
            && request.resource.data.slots['1'].level <= 110
            && request.resource.data.slots['1'].get('gold', 0) >= 0
          )
        )
        && (
          !('2' in request.resource.data.slots)
          || (
            request.resource.data.slots['2'].level is number
            && request.resource.data.slots['2'].level >= 1
            && request.resource.data.slots['2'].level <= 110
            && request.resource.data.slots['2'].get('gold', 0) >= 0
            && exists(/databases/$(database)/documents/entitlements/$(uid))
            && get(/databases/$(database)/documents/entitlements/$(uid)).data.extraSlots >= 1
          )
        );
      allow delete: if isOwner(uid);
    }

    // Só o servidor (ou você, no console) libera slots extras. O jogador lê
    // o próprio direito, mas nunca escreve nele.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /characterNames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && name.size() <= 30;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Id da entrada = "uid_slot" (uma por personagem). O dono é a parte antes do "_".
    match /leaderboard/{entryId} {
      allow read: if signedIn();
      allow delete: if signedIn() && entryId.split('_')[0] == request.auth.uid;
      allow create, update: if signedIn()
        && entryId.split('_')[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 110
        && request.resource.data.power is number
        && request.resource.data.power >= 0
        && request.resource.data.power <= 500000
        // Pontos do Torneio (Combate Ranqueado, ainda travado — ver
        // PvpView.js) — mesmo teto de segurança do power, pra ninguém
        // forjar um valor direto no console e aparecer em 1º sem jogar.
        // Opcional por enquanto: cliente antigo que ainda não salvou
        // depois dessa atualização não manda esse campo.
        && (!('rankedPoints' in request.resource.data)
            || (request.resource.data.rankedPoints is int
                && request.resource.data.rankedPoints >= 0
                && request.resource.data.rankedPoints <= 999999));

      // Reset de temporada do Torneio (ver TournamentRankingModal.js,
      // botão só visível pra conta admin): só esse uid, só o campo
      // rankedPoints, documento já precisa existir (reset não cria
      // entrada nova) — nunca dá acesso a mais nada do registro de
      // outro jogador (nome, nível, power, etc continuam travados pro
      // dono de verdade).
      allow update: if signedIn()
        && request.auth.uid == "qgZA5v7Q1IWLjYc99bNrrRJd14X2"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rankedPoints'])
        && request.resource.data.rankedPoints is int
        && request.resource.data.rankedPoints >= 0
        && request.resource.data.rankedPoints <= 999999;
    }

    // Fazenda compartilhada (ver js/services/FarmSyncService.js): cada
    // personagem logado espelha os 24 canteiros aqui pra outros jogadores
    // poderem visitar. Id = "uid_slot", igual ao leaderboard — o dono é a
    // parte antes do "_". O save de verdade continua privado em /saves.
    match /farms/{farmId} {

      function isFarmOwner() {
        return signedIn() && farmId.split('_')[0] == request.auth.uid;
      }

      // Dia de Brasília (UTC−3) em número — mesma conta de
      // FarmSyncService.today() no jogo.
      function today() {
        return math.floor((request.time.toMillis() - 10800000) / 86400000);
      }

      // Limite diário de roubo (FarmSyncService.DAILY_STEAL_LIMIT): o
      // contador do ladrão nessa fazenda precisa subir exatamente 1 na
      // MESMA transação do roubo, ficando no máximo em 12 no dia de hoje.
      function stealCounterOk() {
        let path = /databases/$(database)/documents/farms/$(farmId)/thieves/$(request.auth.uid);
        let after = getAfter(path).data;
        let countedToday = exists(path) && get(path).data.day == today();
        return after.day == today()
          && after.count <= 12
          && (
            (countedToday && after.count == get(path).data.count + 1)
            || (!countedToday && after.count == 1)
          );
      }

      match /plots/{plotId} {

        function changed(key) {
          return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
        }

        // Horários gravados por visitante precisam ser "agora" (±2 min) —
        // não dá pra regar com um horário no futuro, por exemplo.
        function nearNow(value) {
          return value is int
            && value > request.time.toMillis() - 120000
            && value < request.time.toMillis() + 120000;
        }

        function visitorWaterOk() {
          return !changed('wateredAt') || nearNow(request.resource.data.wateredAt);
        }

        // Tirar praga: só se havia praga, e os 3 campos mudam juntos.
        function visitorPestOk() {
          return changed('pestAt') == changed('pestRemovedAt')
            && (!changed('pestLostMs') || changed('pestAt'))
            && (!changed('pestAt') || (
              resource.data.get('pestAt', null) != null
              && request.resource.data.pestAt == null
              && nearNow(request.resource.data.pestRemovedAt)
              && request.resource.data.pestLostMs is number
              && request.resource.data.pestLostMs >= 0
            ));
        }

        // Roubo: uma vez só por plantio (stolen de 0 pra 2), só com algo
        // plantado, e dentro do limite diário do ladrão nessa fazenda.
        // "Já foi roubado" = stolen já está em 2.
        function visitorStealOk() {
          return (!changed('stolenBy') || changed('stolen'))
            && (!changed('stolen') || (
              resource.data.get('seedId', null) != null
              && resource.data.get('stolen', 0) == 0
              && request.resource.data.stolen == 2
              && request.resource.data.stolenBy is string
              && request.resource.data.stolenBy.size() <= 30
              && stealCounterOk()
            ));
        }

        allow read: if signedIn();
        allow create, update, delete: if isFarmOwner();

        // Visitante: só regar, tirar praga ou roubar — nunca mexe em
        // semente, plantio, terra ou crescimento.
        allow update: if signedIn() && !isFarmOwner()
          && resource.data.tilled == true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['wateredAt', 'pestAt', 'pestLostMs', 'pestRemovedAt', 'stolen', 'stolenBy'])
          && visitorWaterOk()
          && visitorPestOk()
          && visitorStealOk();

      }

      // Contador de roubo de cada visitante nesta fazenda: { day, count }.
      // Só o próprio ladrão escreve, de 1 em 1, e nunca apaga (senão
      // zeraria o limite). Num dia novo recomeça em 1.
      match /thieves/{thiefUid} {

        allow read: if isOwner(thiefUid);

        allow create, update: if isOwner(thiefUid) && !isFarmOwner()
          && request.resource.data.keys().hasOnly(['day', 'count'])
          && request.resource.data.day == today()
          && request.resource.data.count is int
          && request.resource.data.count <= 12
          && (
            ((resource == null || resource.data.day != today()) && request.resource.data.count == 1)
            || (resource != null && resource.data.day == today() && request.resource.data.count == resource.data.count + 1)
          );

      }

      // O que cada visitante fez — o dono lê pro resumo e apaga.
      match /events/{eventId} {

        allow read, delete: if isFarmOwner();

        allow create: if signedIn() && !isFarmOwner()
          && request.resource.data.keys().hasOnly(['type', 'visitorUid', 'visitorName', 'plotIndex', 'cropName', 'amount', 'at'])
          && request.resource.data.visitorUid == request.auth.uid
          && request.resource.data.type in ['water', 'pest', 'steal']
          && request.resource.data.visitorName is string
          && request.resource.data.visitorName.size() <= 30
          && request.resource.data.plotIndex is int
          && request.resource.data.plotIndex >= 0
          && request.resource.data.plotIndex < 24
          && (request.resource.data.cropName == null
              || (request.resource.data.cropName is string && request.resource.data.cropName.size() <= 30))
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 2
          && request.resource.data.at is int;

      }

    }

    // Correio — provisório (ver js/services/MailService.js): só a conta
    // admin abaixo pode mandar carta normal. O uid é o MESMO de
    // js/data/admins.js — os dois precisam ficar sincronizados à mão,
    // regra não lê o array do código. "Devolução automática" (carta
    // expirada depois de 30 dias sem coleta) é a ÚNICA outra forma de
    // criar uma carta, e só pode entrar na caixa do próprio admin — ou
    // seja, mesmo alguém forjando uma devolução falsa não ganha nada
    // pra si, só "suja" a caixa do admin. Quando existir envio
    // jogador→jogador, essa parte da regra precisa ficar bem mais
    // rígida (hoje ela não confirma que a carta original expirada de
    // verdade existiu).
    //
    // A caixa é por CONTA (mail/{uid}), mas uma conta pode ter 2
    // personagens (slots "1"/"2") com o MESMO uid — recipientUid ==
    // auth.uid só é permitido quando senderSlot/recipientSlot existem
    // E são diferentes (mandando pro OUTRO personagem da própria
    // conta); sem os dois slots ou com eles iguais, continua barrado
    // (manda pra si mesmo de verdade).
    match /mail/{recipientUid}/letters/{letterId} {

      allow read, delete: if isOwner(recipientUid);

      allow create: if signedIn()
        && (
          recipientUid != request.auth.uid
          || (request.resource.data.senderSlot is string
              && request.resource.data.recipientSlot is string
              && request.resource.data.senderSlot != request.resource.data.recipientSlot)
        )
        && request.resource.data.senderUid == request.auth.uid
        && (!('senderSlot' in request.resource.data) || request.resource.data.senderSlot == null || (request.resource.data.senderSlot is string && request.resource.data.senderSlot.size() <= 2))
        && (!('recipientSlot' in request.resource.data) || request.resource.data.recipientSlot == null || (request.resource.data.recipientSlot is string && request.resource.data.recipientSlot.size() <= 2))
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 60
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 30
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 250
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3
        && request.resource.data.sentAt is number
        && request.resource.data.expiredReturn is bool
        && (
          (request.auth.uid == "qgZA5v7Q1IWLjYc99bNrrRJd14X2" && request.resource.data.expiredReturn == false)
          || (request.resource.data.expiredReturn == true && recipientUid == "qgZA5v7Q1IWLjYc99bNrrRJd14X2")
        );

    }

  }
}
